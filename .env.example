# =====================================================================
# Variables de entorno · Plataforma de selección de regalos (Kidotoy)
# Copia este archivo a .env.local y rellena los valores reales.
# .env.local NUNCA se versiona (ver .gitignore).
# =====================================================================

# ---- Supabase ----
# Panel de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Service role key: SOLO servidor, salta RLS. NUNCA con prefijo NEXT_PUBLIC_,
# nunca en el cliente. Se usa en operaciones administrativas (fases 3 y 6).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# ---- Empresa activa del piloto ----
# slug de la fila en `empresas`. El layout lee su tema, marca y banner.
NEXT_PUBLIC_EMPRESA_SLUG=acueducto

# ---- Conexión directa a Postgres (SOLO scripts locales, p.ej. db:setup) ----
# Panel de Supabase > Project Settings > Database > Session pooler (puerto 5432).
# NO es la anon/service key: incluye la contraseña de la base. No la usa la app.
SUPABASE_DB_URL=postgresql://postgres.TU-REF:CONTRASEÑA@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---- Correo (Resend) · Fase 6 ----
RESEND_API_KEY=re_tu_api_key
# Remitente. En el piloto sirve el de pruebas de Resend; en producción hay que
# verificar el dominio y usar uno propio (p. ej. "Kidotoy <regalos@kidotoy.co>").
RESEND_FROM=Kidotoy <onboarding@resend.dev>
# Destino del resumen diario a Kidotoy.
RESUMEN_EMAIL=kidotoy@example.com

# ---- Cron protegido (resumen diario) · Fase 6 ----
# Secreto compartido con el cron externo para la ruta del resumen diario.
# Se envía como header x-cron-secret o ?secret= al llamar /api/resumen-diario.
CRON_SECRET=genera-un-secreto-largo-y-aleatorio
